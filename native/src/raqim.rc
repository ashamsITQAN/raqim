1 ICON "@ICON@"
1 VERSIONINFO
FILEVERSION @VERC@,0
PRODUCTVERSION @VERC@,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "itqan.dev"
      VALUE "FileDescription", "Raqim - Recitation Audio Quran Integrated Manager"
      VALUE "FileVersion", "@VER@"
      VALUE "ProductName", "Raqim"
      VALUE "ProductVersion", "@VER@"
      VALUE "OriginalFilename", "Raqim-@VER@.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
